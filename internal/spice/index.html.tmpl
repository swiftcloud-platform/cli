<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cloud VM Console</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #1a1a2e; font-family: system-ui, sans-serif; }
  #status {
    position: fixed; top: 12px; left: 12px; z-index: 100;
    padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 500;
    background: rgba(0,0,0,0.7); color: #aaa; pointer-events: none;
    transition: opacity 0.3s;
  }
  #status.connected { color: #4ade80; }
  #status.error { color: #f87171; }
  #toolbar {
    position: fixed; bottom: 12px; left: 50%; transform: translateX(-50%); z-index: 100;
    display: flex; gap: 8px; opacity: 0; transition: opacity 0.3s;
  }
  body:hover #toolbar { opacity: 1; }
  .btn {
    padding: 6px 16px; border: none; border-radius: 6px; cursor: pointer;
    font-size: 13px; font-weight: 500; background: rgba(0,0,0,0.7); color: #ddd;
  }
  .btn:hover { background: rgba(0,0,0,0.9); }
  #display {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    color: #666; font-size: 14px;
  }
  canvas { display: block; image-rendering: pixelated; }
</style>
</head>
<body>
<div id="status">Connecting…</div>
<div id="display"></div>
<div id="toolbar">
  <button class="btn" onclick="sendCtrlAltDel()">Ctrl+Alt+Del</button>
  <button class="btn" onclick="toggleFullscreen()">Fullscreen</button>
</div>

<script src="/spice-client.min.js"></script>
<script>
(function() {
  var params = new URLSearchParams(window.location.search);
  var ticket = params.get('ticket');

  if (!ticket) {
    setStatus('Missing connection parameters', 'error');
    return;
  }

  // Connect to the local proxy — it bridges to the platform's console WebSocket.
  var wsUrl = 'ws://' + window.location.host + '/ws';

  var display = document.getElementById('display');
  var canvas = document.createElement('canvas');
  canvas.width = 1024;
  canvas.height = 768;
  display.appendChild(canvas);

  var spiceConn = null;

  function setStatus(text, cls) {
    var el = document.getElementById('status');
    el.textContent = text;
    el.className = cls || '';
  }

  function onSPICEConnected() {
    setStatus('Connected', 'connected');
    setTimeout(function() { document.getElementById('status').style.opacity = '0'; }, 2000);
  }

  function onSPICEDisconnected() {
    setStatus('Disconnected', 'error');
  }

  function onSPICEError(e) {
    setStatus('Error: ' + (e.message || e), 'error');
  }

  try {
    spiceConn = new SpiceClient.SpiceMainConn({
      uri: wsUrl,
      ticket: ticket,
      canvas: canvas,
      onsuccess: onSPICEConnected,
      onerror: onSPICEError,
      ondisconnect: onSPICEDisconnected
    });
  } catch(e) {
    onSPICEError(e);
  }

  window.sendCtrlAltDel = function() {
    if (spiceConn && spiceConn.inputs) {
      spiceConn.inputs.KeyDown(29);   // Ctrl
      spiceConn.inputs.KeyDown(56);   // Alt
      spiceConn.inputs.KeyDown(83);   // Delete
      spiceConn.inputs.KeyUp(83);
      spiceConn.inputs.KeyUp(56);
      spiceConn.inputs.KeyUp(29);
    }
  };

  window.toggleFullscreen = function() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(function(){});
    } else {
      document.exitFullscreen();
    }
  };

  document.addEventListener('mousemove', function() {
    document.getElementById('status').style.opacity = '1';
  });
})();
</script>
</body>
</html>
